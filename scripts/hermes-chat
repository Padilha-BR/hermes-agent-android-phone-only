#!/data/data/com.termux/files/usr/bin/bash
# hermes-chat — abre o chat NATIVO do Hermes no celular (app próprio, cara de desktop).
# Servido localmente na 8891; fala o protocolo WebSocket do gateway.
PORT="${HERMES_CHAT_PORT:-8891}"
URL="http://127.0.0.1:$PORT"
H="$HOME/.hermes"
APP="$H/chat"
LOG="$H/logs/chat-server.log"
mkdir -p "$H/logs"

[ -f "$APP/index.html" ] || { echo "app de chat ainda nao existe em $APP"; exit 1; }

if ! curl -s -o /dev/null --max-time 3 "$URL/__health"; then
  HERMES_DESKTOP_WEB="$APP" HERMES_DESKTOP_WEB_PORT="$PORT" \
  HERMES_WEB_LOG="$H/logs/chat-telemetria.log" \
    setsid nohup python "$H/bin/hermes-desktop-web.py" >>"$LOG" 2>&1 </dev/null &
  for _ in $(seq 1 15); do sleep 1; curl -s -o /dev/null --max-time 3 "$URL/__health" && break; done
fi

curl -s -o /dev/null --max-time 3 "$URL/__health" || { echo "nao subiu — veja $LOG"; exit 1; }

echo "Chat do Hermes no ar: $URL"
echo -n "$URL" | termux-clipboard-set 2>/dev/null
termux-open-url "$URL" >/dev/null 2>&1
am start -a android.intent.action.VIEW -d "$URL" >/dev/null 2>&1
