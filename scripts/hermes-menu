#!/data/data/com.termux/files/usr/bin/bash
# hermes-menu — menu do Hermes feito para toque: toque o número e Enter.
URL="http://127.0.0.1:9119"

status() {
  H=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$URL/api/health" 2>/dev/null)
  [ "$H" = "200" ] && echo "  app (dashboard 9119): NO AR" || echo "  app (dashboard 9119): fora do ar"
  W=$(awk '{print $1}' "$HOME/.hermes/state/dashboard-watchdog.pid" 2>/dev/null)
  if [ -n "$W" ] && kill -0 "$W" 2>/dev/null; then echo "  vigia do app: ativo (pid $W)"; else echo "  vigia do app: PARADO"; fi
  free -m 2>/dev/null | awk 'NR==2 {printf "  memoria: %s MB disponiveis\n", $4+$6}'
}

while true; do
  echo
  echo "  === HERMES NO CELULAR ==="
  echo "  1) Conversar (nova conversa)"
  echo "  2) Continuar a ultima conversa"
  echo "  3) Abrir o APP (tela clicavel)"
  echo "  4) Status (app / memoria)"
  echo "  5) Aliviar o celular (builds)"
  echo "  0) Sair"
  printf "  escolha> "
  read -r op
  case "$op" in
    1) exec hermes-mobile ;;
    2) exec hermes-mobile --continue ;;
    3) hermes-app ;;
    4) status ;;
    5) hermes-calm ;;
    0 | q | "") exit 0 ;;
    *) echo "  opcao invalida" ;;
  esac
done
