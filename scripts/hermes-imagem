#!/data/data/com.termux/files/usr/bin/bash
# hermes-imagem — escolher foto do celular com miniatura (popup igual app) e
# mandar direto pro Hermes, já com a imagem anexada.
# O seletor (hermes-picker.py) exige um token por execução: ele o grava em
# state/picker-token (0600) ao subir e este script abre a URL com ?t=<token>.
# O seletor encerra sozinho depois da escolha (ou ocioso), não fica residente.
PORT="${HERMES_PICKER_PORT:-8898}"
URL="http://127.0.0.1:$PORT"
H="$HOME/.hermes"
QUEUE="$H/state/picker-queue.json"
TOKFILE="$H/state/picker-token"
LOG="$H/logs/picker.log"
mkdir -p "$H/state" "$H/logs"

up() { curl -s -o /dev/null --max-time 3 "$URL/health"; }

# seletor de versão antiga (sem token) ainda residente: derruba antes de subir o novo
if up && [ ! -s "$TOKFILE" ]; then
  pkill -f 'hermes-picker\.py' 2>/dev/null
  sleep 1
fi
if ! up; then
  setsid nohup "$H/bin/hermes-picker.py" >>"$LOG" 2>&1 </dev/null &
  for _ in $(seq 1 15); do sleep 1; up && [ -s "$TOKFILE" ] && break; done
fi
TOK=$(cat "$TOKFILE" 2>/dev/null)
if ! up || [ -z "$TOK" ]; then
  echo "Nao consegui subir o seletor de fotos. Veja $LOG"
  exit 1
fi

# limpa escolha anterior (caminho passado como argumento, nunca colado no código)
python -c 'import os,sys;p=sys.argv[1];os.path.exists(p) and os.remove(p)' "$QUEUE" 2>/dev/null

am start -a android.intent.action.VIEW -d "$URL/?t=$TOK" >/dev/null 2>&1
echo "Abri o seletor de fotos no navegador."
echo "Toque nas fotos, escreva a pergunta (opcional) e toque em 'Mandar (N)'."
echo "Aguardando sua escolha..."

for _ in $(seq 1 300); do
  [ -f "$QUEUE" ] && break
  sleep 2
done

if [ ! -f "$QUEUE" ]; then
  echo "Nenhuma foto escolhida (desisti depois de 10 min). Rode 'hermes-imagem' de novo quando quiser."
  exit 1
fi

# $QUEUE vai como argv: interpolado dentro do código Python, um caminho com
# aspa quebrava (ou injetava) o script
ler() { python -c 'import json,sys
d=json.load(open(sys.argv[1],encoding="utf-8"))
p=d.get("paths") or []
c=sys.argv[2]
print(p[0] if c=="img" and p else d.get("question","").strip() if c=="q" else ", ".join(p[1:]) if c=="extras" else "")' "$QUEUE" "$1" 2>/dev/null; }
IMG=$(ler img)
PERGUNTA=$(ler q)
EXTRAS=$(ler extras)
python -c 'import os,sys;p=sys.argv[1];os.path.exists(p) and os.remove(p)' "$QUEUE" 2>/dev/null

if [ -z "$IMG" ]; then
  echo "A escolha chegou vazia. Tente de novo."
  exit 1
fi

[ -z "$PERGUNTA" ] && PERGUNTA="Olha essa imagem que eu mandei do celular e me diz o que você vê."
[ -n "$EXTRAS" ] && PERGUNTA="$PERGUNTA (Também escolhi estas outras imagens, leia cada uma: $EXTRAS)"

echo "Foto: $IMG"
echo "───────────────────────────────────────────────"
exec hermes-mobile chat -q "$PERGUNTA" --image "$IMG"
